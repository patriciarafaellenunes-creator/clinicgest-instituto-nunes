# Supabase — cole os valores do seu projeto (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Service role — SOMENTE para rotas de servidor (import/processamento). Nunca expor ao client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Anthropic (Claude API) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Modelos usados pelo worker de IA (§10 do PRD). Padrão: claude-opus-5 para os dois.
# Ajustável por conta e risco do operador — nunca altere para reduzir custo sem avaliar qualidade.
ANTHROPIC_CLASSIFY_MODEL=claude-opus-5
ANTHROPIC_MESSAGE_MODEL=claude-opus-5

# Opcional (V1): segredo compartilhado para permitir que um cron externo
# chame POST /api/import/process sem uma sessão de usuário.
CRON_SECRET=
