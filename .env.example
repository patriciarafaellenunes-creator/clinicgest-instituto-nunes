PGHOST=localhost
PGPORT=5432
PGUSER=app_user
PGPASSWORD=troque-esta-senha
PGDATABASE=clinicgest
JWT_SECRET=troque-este-segredo
PORT=3000
# URL pública do frontend em produção (Vercel) — trava o CORS só nesse
# domínio. Deixe vazio em desenvolvimento local.
FRONTEND_URL=
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
ANTHROPIC_MODEL=claude-sonnet-5

# Credenciais separadas, só para login e bootstrap-clinic (precisam do
# atributo BYPASSRLS no Postgres — ver 03-row-level-security.sql). Nunca
# use essas credenciais nas rotas normais da aplicação.
AUTH_PGUSER=auth_service_user
AUTH_PGPASSWORD=troque-esta-outra-senha
