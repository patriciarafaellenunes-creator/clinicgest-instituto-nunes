PGHOST=localhost
PGPORT=5432
PGUSER=app_user
PGPASSWORD=troque-esta-senha
PGDATABASE=clinicgest
JWT_SECRET=troque-este-segredo
PORT=3000
# URL pública do frontend em produção (Vercel) — trava o CORS só nesse
# domínio. Deixe vazio em desenvolvimento local.
FRONTEND_URL=
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
ANTHROPIC_MODEL=claude-sonnet-5

# Credenciais separadas, só para login e bootstrap-clinic (precisam do
# atributo BYPASSRLS no Postgres — ver 03-row-level-security.sql). Nunca
# use essas credenciais nas rotas normais da aplicação.
AUTH_PGUSER=auth_service_user
AUTH_PGPASSWORD=troque-esta-outra-senha

# Sem essa variável, POST /api/auth/bootstrap-clinic fica aberto para
# qualquer pessoa que encontrar a URL criar uma clínica nova. Defina um
# segredo forte (ex: openssl rand -hex 24) em produção — toda chamada ao
# endpoint passa a exigir o mesmo valor no campo "setupToken" do corpo.
# Deixe vazio em desenvolvimento local/testes.
BOOTSTRAP_SETUP_TOKEN=
